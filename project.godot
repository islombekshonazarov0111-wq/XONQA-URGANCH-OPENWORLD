; Xonqa–Urganch Open World
; Foundation target: Godot 4.7.x
config_version=5

[application]
config/name="Xonqa Urganch Open World"
run/main_scene="res://scenes/world/Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[autoload]
GameState="*res://autoload/GameState.gd"
Settings="*res://autoload/Settings.gd"
VehicleDatabase="*res://autoload/VehicleDatabase.gd"

[input]
accelerate={"deadzone":0.2,"events":[]}
brake={"deadzone":0.2,"events":[]}
handbrake={"deadzone":0.2,"events":[]}
interact={"deadzone":0.2,"events":[]}
